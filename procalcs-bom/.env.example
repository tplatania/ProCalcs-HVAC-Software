# ==================================================
# ProCalcs BOM — Environment Variables Template
# Copy this file to .env.local for local development
# NEVER commit .env or .env.local to version control
# ==================================================

# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Anthropic AI
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# Google Cloud / Firestore
FIRESTORE_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# CORS — comma-separated list of allowed frontend origins.
# Whitespace and empty entries are tolerated.
# Add the Designer Dashboard origin once it calls the BOM service directly.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://procalcs-dashboard-w7vvclyqya-ue.a.run.app

# Admin emails — comma-separated
ADMIN_EMAILS=tom@procalcs.net

# Shared-secret auth — every caller (Designer Desktop BFF, Designer
# Dashboard backend, etc.) must send this exact value in the
# X-Procalcs-Service-Token header. Rotate by changing here + all clients.
# Missing/blank fails closed. Local development must explicitly set
# ALLOW_INSECURE_NO_AUTH=1 when running without a shared secret.
SERVICE_SHARED_SECRET=change-me-to-a-long-random-string
ALLOW_INSECURE_NO_AUTH=0

# External identity -> allowed contractor IDs. Exact emails take priority;
# domain keys apply to everyone on that domain. Internal-domain users retain
# cross-client access. Keep this server-side; the browser is not a boundary.
INTERNAL_DOMAIN=procalcs.net
CLIENT_SCOPE_RULES_JSON={"reliableheating.team":["reliable-heating-and-cooling"]}

# Logging
LOG_LEVEL=INFO
