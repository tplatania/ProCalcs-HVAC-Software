<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ job_id or "Bill of Materials" }}</title>
<style>
  @page {
    size: Letter;
    margin: 0.75in 0.75in 1in 0.75in;
    @bottom-left {
      content: "Generated via ProCalcs Designer Desktop";
      font-family: "DejaVu Sans", sans-serif;
      font-size: 8pt;
      color: #94a3b8;
    }
    @bottom-right {
      content: "Page " counter(page) " of " counter(pages);
      font-family: "DejaVu Sans", sans-serif;
      font-size: 8pt;
      color: #94a3b8;
    }
  }

  body {
    font-family: "DejaVu Sans", sans-serif;
    font-size: 10pt;
    color: #1e293b;
    margin: 0;
  }

  /* ===== Header ===== */
  .brand-header {
    margin-bottom: 18pt;
  }
  .brand-row {
    display: flex;
    align-items: center;
    gap: 14pt;
  }
  .brand-logo {
    max-height: 48pt;
    max-width: 160pt;
  }
  .brand-name {
    font-size: 24pt;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.5pt;
    margin: 0;
  }
  .brand-bar {
    height: 4pt;
    background: {{ brand_color or "#f97316" }};
    width: 60pt;
    margin-top: 4pt;
  }
  .brand-sub {
    font-size: 11pt;
    color: #64748b;
    margin-top: 8pt;
  }

  /* ===== Job metadata banner ===== */
  .job-meta {
    border: 1pt solid #e2e8f0;
    border-radius: 6pt;
    padding: 10pt 14pt;
    margin-bottom: 16pt;
    background: #f8fafc;
  }
  .job-meta table {
    width: 100%;
    border-collapse: collapse;
  }
  .job-meta td {
    padding: 3pt 8pt 3pt 0;
    vertical-align: top;
  }
  /* Vertical two-column layout: fixed-width label column, value fills. */
  .job-meta td.label {
    font-size: 8pt;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    color: #64748b;
    font-weight: 600;
    width: 90pt;
    white-space: nowrap;
  }
  .job-meta td.value {
    font-size: 10pt;
    font-weight: 500;
    color: #1e293b;
  }
  .job-meta tr.total td {
    border-top: 1pt solid #e2e8f0;
    padding-top: 6pt;
  }
  .job-meta tr.total td.value {
    font-size: 12pt;
    font-weight: 700;
    color: #f97316;
  }

  /* ===== Category tables ===== */
  .category {
    margin-bottom: 14pt;
    page-break-inside: auto;
  }
  .category-header {
    display: flex;
    align-items: center;
    padding: 6pt 10pt;
    border-radius: 4pt 4pt 0 0;
    color: #1e293b;
    font-weight: 600;
    font-size: 11pt;
  }
  .category-header .chip {
    display: inline-block;
    width: 10pt;
    height: 10pt;
    border-radius: 2pt;
    margin-right: 6pt;
    vertical-align: middle;
  }
  .category-count {
    font-size: 9pt;
    color: #64748b;
    font-weight: 400;
    margin-left: 8pt;
  }

  table.items {
    width: 100%;
    border-collapse: collapse;
    border: 1pt solid #e2e8f0;
  }
  table.items thead {
    background: #f1f5f9;
  }
  table.items th {
    text-align: left;
    font-size: 8pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3pt;
    color: #64748b;
    padding: 5pt 8pt;
    border-bottom: 1pt solid #e2e8f0;
  }
  table.items th.num,
  table.items td.num {
    text-align: right;
  }
  table.items tbody tr {
    page-break-inside: avoid;
  }
  table.items td {
    padding: 5pt 8pt;
    border-bottom: 1pt solid #f1f5f9;
    font-size: 9pt;
  }
  table.items tbody tr:last-child td {
    border-bottom: none;
  }
  table.items tfoot td {
    background: #f8fafc;
    border-top: 1pt solid #e2e8f0;
    font-weight: 600;
    padding: 6pt 8pt;
  }

  /* ===== Grand total ===== */
  .grand-total {
    margin-top: 20pt;
    padding: 12pt 16pt;
    border: 1pt solid #f97316;
    border-radius: 6pt;
    background: #fff7ed;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .grand-total.partial {
    border-color: #f59e0b;
    background: #fffbeb;
  }
  .grand-total .label {
    font-size: 11pt;
    font-weight: 600;
    color: #1e293b;
  }
  .grand-total .label small {
    display: block;
    font-size: 8pt;
    font-weight: 400;
    color: #b45309;
    margin-top: 2pt;
  }
  .grand-total .amount {
    font-size: 20pt;
    font-weight: 700;
    color: #f97316;
  }
  .grand-total.partial .amount {
    color: #b45309;
  }

  /* ===== Output mode note ===== */
  .mode-note {
    font-size: 8pt;
    color: #94a3b8;
    margin-top: 4pt;
    text-align: right;
  }

  /* ===== Provenance summary ===== */
  /* Only renders when has_provenance is true. Mirrors the SPA's BOM
     output card so PDF readers see the same trust gradient. */
  .provenance {
    border: 1pt solid #e2e8f0;
    border-radius: 6pt;
    padding: 8pt 14pt;
    margin-bottom: 16pt;
    background: #ffffff;
    display: flex;
    align-items: center;
    gap: 14pt;
    flex-wrap: wrap;
    font-size: 9pt;
  }
  .provenance .pchip {
    display: inline-block;
    padding: 2pt 6pt;
    border-radius: 3pt;
    font-weight: 600;
    margin-right: 4pt;
  }
  .provenance .pchip.rules {
    background: #ecfdf5;
    color: #047857;
    border: 0.5pt solid #6ee7b7;
  }
  .provenance .pchip.ai {
    background: #fffbeb;
    color: #b45309;
    border: 0.5pt solid #fcd34d;
  }
  .provenance .pnote {
    color: #94a3b8;
    font-size: 8pt;
    margin-left: auto;
  }

  /* ===== Source/SKU columns ===== */
  table.items td.sku {
    font-family: "DejaVu Sans Mono", monospace;
    font-size: 8pt;
    color: #64748b;
  }
  .src-badge {
    display: inline-block;
    padding: 1pt 5pt;
    border-radius: 2pt;
    font-size: 7.5pt;
    font-weight: 600;
    letter-spacing: 0.3pt;
  }
  .src-badge.rules {
    background: #ecfdf5;
    color: #047857;
    border: 0.5pt solid #6ee7b7;
  }
  .src-badge.ai {
    background: #fffbeb;
    color: #b45309;
    border: 0.5pt solid #fcd34d;
  }
</style>
</head>
<body>

<!-- ===== Brand header ===== -->
<div class="brand-header">
  <div class="brand-row">
    {% if logo_url %}
      <img class="brand-logo" src="{{ logo_url }}" alt="">
    {% endif %}
    <div>
      <h1 class="brand-name">{{ project_name or "Bill of Materials" }}</h1>
      <div class="brand-bar"></div>
      <p class="brand-sub">HVAC Bill of Materials{% if contractor_display_name %} — {{ contractor_display_name }}{% endif %}</p>
    </div>
  </div>
</div>

<!-- ===== Job metadata banner (Dana #8/#10 — vertical, EST) ===== -->
<div class="job-meta">
  <table>
    <tr>
      <td class="label">Project</td>
      <td class="value">{{ project_name or "—" }}</td>
    </tr>
    {% if project_address %}
    <tr>
      <td class="label">Address</td>
      <td class="value">{{ project_address }}</td>
    </tr>
    {% endif %}
    <tr>
      <td class="label">Client</td>
      <td class="value">{{ client_name or "—" }}{% if supplier %} <span style="color:#94a3b8">({{ supplier }})</span>{% endif %}</td>
    </tr>
    <tr>
      <td class="label">Generated</td>
      <td class="value">{{ generated_display or generated_at or "—" }}</td>
    </tr>
    {% if not hide_pricing %}
    <tr class="total">
      <td class="label">Grand Total</td>
      <td class="value">{{ grand_total | currency }}</td>
    </tr>
    {% else %}
    <tr class="total">
      <td class="label">Pricing</td>
      <td class="value" style="font-size:10pt;color:#64748b;font-weight:600;">Parts list only — no pricing</td>
    </tr>
    {% endif %}
  </table>
</div>

<!-- ===== Provenance summary (rules vs AI) ===== -->
{% if has_provenance %}
<div class="provenance">
  <span><span class="pchip rules">{{ rules_count }}</span> rules-engine line{{ '' if rules_count == 1 else 's' }} (deterministic)</span>
  <span><span class="pchip ai">{{ ai_count }}</span> AI-estimated line{{ '' if ai_count == 1 else 's' }} (review)</span>
  <span class="pnote">Rules-engine quantities are emitted from the catalog and won't change between runs.</span>
</div>
{% endif %}

{% if quick_order_summary %}
<!-- ===== Quick Order Summary (Day-17 / Tom's #1) ===== -->
<div style="margin-top: 14pt; margin-bottom: 14pt;">
  <div style="background: #1e293b; color: #fff; padding: 6pt 10pt; border-top-left-radius: 5pt; border-top-right-radius: 5pt;">
    <span style="font-size: 11pt; font-weight: 700; letter-spacing: 0.5pt;">QUICK ORDER SUMMARY</span>
    <span style="font-size: 8pt; color: #cbd5e1; margin-left: 6pt;">— buy at these quantities; detailed runs below</span>
  </div>
  <table style="width: 100%; border-collapse: collapse; font-size: 9pt; border: 1pt solid #1e293b; border-top: none;">
    <thead style="display: table-header-group;">
      <tr style="background: #f1f5f9;">
        <th style="text-align: left; padding: 4pt 8pt; border-bottom: 0.5pt solid #cbd5e1;">CATEGORY</th>
        <th style="text-align: left; padding: 4pt 8pt; border-bottom: 0.5pt solid #cbd5e1;">SIZE</th>
        <th style="text-align: left; padding: 4pt 8pt; border-bottom: 0.5pt solid #cbd5e1;">ITEM</th>
        <th style="text-align: right; padding: 4pt 8pt; border-bottom: 0.5pt solid #cbd5e1;">TOTAL</th>
        <th style="text-align: left; padding: 4pt 8pt; border-bottom: 0.5pt solid #cbd5e1;">ORDER AS</th>
      </tr>
    </thead>
    <tbody>
      {% set ns = namespace(prev_cat='') %}
      {% for r in quick_order_summary %}
        <tr style="background: {{ '#fafbfc' if loop.index is even else '#ffffff' }};">
          <td style="padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0; {% if r.category != ns.prev_cat %}font-weight: 600;{% else %}color: #94a3b8;{% endif %}">
            {% if r.category != ns.prev_cat %}{{ r.category }}{% set ns.prev_cat = r.category %}{% else %}&nbsp;{% endif %}
          </td>
          <td style="padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0; font-family: monospace;">{{ r.size or '—' }}</td>
          <td style="padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0; color: #475569; font-size: 8.5pt;">{{ r.label }}</td>
          <td style="text-align: right; padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0; font-weight: 600; tabular-nums;">{{ "%.2f"|format(r.total) }} {{ r.unit }}</td>
          <td style="padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0;">
            {# Day-17 — pluralization rule shared with SPA + XLS:
               ea → never pluralizes; box → "boxes"; everything else → +s.
               Applied to BOTH per-container paths so consumable rows
               (per_container == 1) get the same treatment as duct rows. #}
            {% set _plural_suffix = ('' if r.containers == 1 else ('es' if r.container == 'box' else ('' if r.container == 'ea' else 's'))) %}
            {% if r.per_container > 1 %}
              <strong>{{ r.containers }} {{ r.container }}{{ _plural_suffix }}</strong>
              <span style="color: #94a3b8; font-size: 7.5pt;">({{ r.per_container|int }} {{ r.unit }} each)</span>
            {% else %}
              <strong>{{ r.containers }} {{ r.container }}{{ _plural_suffix }}</strong>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{% if duct_cuts_summary %}
<!-- ===== Day-17 — Per-piece Duct Cuts (Richard Jun 30) =====
     Every flex / rigid duct cut listed with length + joints. Each
     cut is two end joints needing fastener + mastic + tape. -->
<div style="margin-top: 14pt; margin-bottom: 14pt;">
  <div style="background: #334155; color: #fff; padding: 6pt 10pt; border-top-left-radius: 5pt; border-top-right-radius: 5pt;">
    <span style="font-size: 11pt; font-weight: 700; letter-spacing: 0.5pt;">DUCT CUTS (PER PIECE)</span>
    <span style="font-size: 8pt; color: #cbd5e1; margin-left: 6pt;">— each end of every run is a sealed joint</span>
  </div>
  <table style="width: 100%; border-collapse: collapse; font-size: 9pt; border: 1pt solid #334155; border-top: none;">
    <thead style="display: table-header-group;">
      <tr style="background: #f1f5f9;">
        <th style="text-align: left; padding: 4pt 8pt; border-bottom: 0.5pt solid #cbd5e1;">FAMILY</th>
        <th style="text-align: left; padding: 4pt 8pt; border-bottom: 0.5pt solid #cbd5e1;">SIZE</th>
        <th style="text-align: left; padding: 4pt 8pt; border-bottom: 0.5pt solid #cbd5e1;">CUT</th>
        <th style="text-align: right; padding: 4pt 8pt; border-bottom: 0.5pt solid #cbd5e1;">LENGTH</th>
        <th style="text-align: right; padding: 4pt 8pt; border-bottom: 0.5pt solid #cbd5e1;">JOINTS</th>
      </tr>
    </thead>
    <tbody>
      {% for g in duct_cuts_summary %}
      <tr style="background: #f8fafc; font-weight: 600;">
        <td style="padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0;">{{ g.family }}</td>
        <td style="padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0; font-family: monospace;">{{ g.size }}</td>
        <td style="padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0; color: #64748b; font-size: 8pt;">{{ g.cut_count }} cut{{ '' if g.cut_count == 1 else 's' }}</td>
        <td style="text-align: right; padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0; tabular-nums;">{{ "%.2f"|format(g.total_length) }} ft</td>
        <td style="text-align: right; padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0; tabular-nums;">{{ g.total_joints }}</td>
      </tr>
      {% for c in g.cuts %}
      <tr>
        <td style="padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0;">&nbsp;</td>
        <td style="padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0;">&nbsp;</td>
        <td style="padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0; color: #94a3b8; font-size: 8pt;">#{{ loop.index }}</td>
        <td style="text-align: right; padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0; color: #475569; font-size: 8.5pt;">{{ "%.2f"|format(c.length) }} ft</td>
        <td style="text-align: right; padding: 3pt 8pt; border-bottom: 0.5pt solid #e2e8f0; color: #475569; font-size: 8.5pt;">{{ c.joints }}</td>
      </tr>
      {% endfor %}
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

<!-- ===== Category tables ===== -->
{% for group in groups %}
<div class="category">
  <div class="category-header" style="background: {{ group.meta.bg }};">
    <span class="chip" style="background: {{ group.meta.color }};"></span>
    {{ group.meta.label }}
    <span class="category-count">{{ group.lines | length }} items{% if not hide_pricing %} · {{ group.subtotal | currency }}{% endif %}</span>
  </div>

  {# Day-17 — unified column set: Generic | Description | Mfr | SKU |
     Qty | Unit | Unit $ | Total — same shape as the XLS export and SPA
     line-items table so contractors see consistent data across all
     three artifacts. Markup column removed (was PDF-only). #}
  <table class="items">
    <thead style="display: table-header-group;">
      <tr>
        <th class="num" style="width: 24pt;">#</th>
        <th>Generic</th>
        <th>Description</th>
        <th>Mfr</th>
        <th>SKU</th>
        <th class="num">Qty</th>
        <th>Unit</th>
        {% if not hide_pricing %}
        <th class="num">Unit $</th>
        <th class="num">Total</th>
        {% endif %}
      </tr>
    </thead>
    <tbody>
      {% for item in group.lines %}
      <tr>
        <td class="num" style="color: #94a3b8;">{{ loop.index + group.start_index }}</td>
        <td class="sku">{{ item.generic_id or item.sku or "—" }}</td>
        <td>{{ item.description or "(unnamed)" }}</td>
        <td>{{ item.manufacturer or "—" }}</td>
        <td class="sku">{{ item.sku or "—" }}</td>
        <td class="num">{{ item.quantity | qty }}</td>
        <td>{{ item.unit or "EA" }}</td>
        {% if not hide_pricing %}
        <td class="num">{{ (item.get('unit_price') if item.get('unit_price') is not none else item.get('unit_cost')) | currency }}</td>
        <td class="num">{{ (item.get('total_price') if item.get('total_price') is not none else item.get('total_cost')) | currency }}</td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
    {% if not hide_pricing %}
    <tfoot>
      <tr>
        <td colspan="8" class="num">{{ group.meta.label }} Subtotal</td>
        <td class="num">{{ group.subtotal | currency }}</td>
      </tr>
    </tfoot>
    {% endif %}
  </table>
</div>
{% endfor %}

<!-- ===== Grand total ===== -->
{% if hide_pricing %}
<div class="mode-note">{{ item_count }} line items · parts list only (no pricing)</div>
{% else %}
<div class="grand-total{% if is_partial_pricing %} partial{% endif %}">
  <span class="label">
    {% if is_partial_pricing %}
      Partial Total
      <small>{{ priced_count }} of {{ item_count }} lines priced · upload contractor pricing for the full BOM</small>
    {% else %}
      Grand Total — {{ output_mode.replace('_', ' ').title() }}
    {% endif %}
  </span>
  <span class="amount">{{ grand_total | currency }}</span>
</div>
<div class="mode-note">{{ item_count }} line items · output mode: {{ output_mode }}</div>
{% endif %}

{% if ahri_specs %}
<!-- ===== Equipment Specifications (AHRI-certified) ===== -->
<div style="margin-top: 24pt; page-break-inside: avoid;">
  <h3 style="font-size: 12pt; color: #1e293b; margin: 0 0 6pt 0;">
    Equipment Specifications
  </h3>
  <p style="font-size: 8pt; color: #64748b; margin: 0 0 8pt 0;">
    AHRI-certified ratings for equipment listed in this BOM.
  </p>
  <table style="width: 100%; border-collapse: collapse; font-size: 8.5pt;">
    <thead>
      <tr style="background: #f1f5f9;">
        <th style="text-align: left; padding: 5pt 6pt; border-bottom: 1pt solid #cbd5e1;">Model / Description</th>
        <th style="text-align: left; padding: 5pt 6pt; border-bottom: 1pt solid #cbd5e1;">Type</th>
        <th style="text-align: right; padding: 5pt 6pt; border-bottom: 1pt solid #cbd5e1;">Capacity (BTU)</th>
        <th style="text-align: right; padding: 5pt 6pt; border-bottom: 1pt solid #cbd5e1;">SEER</th>
        <th style="text-align: right; padding: 5pt 6pt; border-bottom: 1pt solid #cbd5e1;">HSPF</th>
        <th style="text-align: right; padding: 5pt 6pt; border-bottom: 1pt solid #cbd5e1;">EER95</th>
        <th style="text-align: right; padding: 5pt 6pt; border-bottom: 1pt solid #cbd5e1;">AFUE</th>
        <th style="text-align: left; padding: 5pt 6pt; border-bottom: 1pt solid #cbd5e1;">AHRI Ref</th>
      </tr>
    </thead>
    <tbody>
      {% for s in ahri_specs %}
        <tr>
          <td style="padding: 4pt 6pt; border-bottom: 0.5pt solid #e2e8f0;">
            <div style="font-weight: 600;">{{ s.condenser_model or s.generic_id }}</div>
            <div style="color: #64748b; font-size: 7.5pt;">{{ s.trade_name or s.description }} — {{ s.manufacturer or "—" }}</div>
          </td>
          <td style="padding: 4pt 6pt; border-bottom: 0.5pt solid #e2e8f0;">{{ s.product_type or "—" }}</td>
          <td style="text-align: right; padding: 4pt 6pt; border-bottom: 0.5pt solid #e2e8f0;">{{ "{:,}".format(s.capacity_btu) if s.capacity_btu else "—" }}</td>
          <td style="text-align: right; padding: 4pt 6pt; border-bottom: 0.5pt solid #e2e8f0;">{{ s.seer if s.seer is not none else "—" }}</td>
          <td style="text-align: right; padding: 4pt 6pt; border-bottom: 0.5pt solid #e2e8f0;">{{ s.hspf if s.hspf is not none else "—" }}</td>
          <td style="text-align: right; padding: 4pt 6pt; border-bottom: 0.5pt solid #e2e8f0;">{{ s.eer95 if s.eer95 is not none else "—" }}</td>
          <td style="text-align: right; padding: 4pt 6pt; border-bottom: 0.5pt solid #e2e8f0;">{{ s.afue if s.afue is not none else "—" }}</td>
          <td style="padding: 4pt 6pt; border-bottom: 0.5pt solid #e2e8f0; font-family: monospace; font-size: 8pt;">{{ s.ari_refno if s.ari_refno and s.ari_refno != "0" else "—" }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

</body>
</html>
